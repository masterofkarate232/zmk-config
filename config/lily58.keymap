#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    combos {
        compatible = "zmk,combos";

        Function {
            bindings = <&mo 5>;
            key-positions = <52 55>;
        };

        Sym {
            bindings = <&mo 3>;
            key-positions = <52 54>;
        };

        homerowmods {
            bindings = <&mo 9>;
            key-positions = <53 54>;
        };

        qwerty {
            bindings = <&tog 1>;
            key-positions = <23 35>;
        };

        graphite {
            bindings = <&tog 0>;
            key-positions = <10 11>;
        };

        onehanddel {
            bindings = <&kp DEL>;
            key-positions = <0 3>;
        };

        mouse-lh {
            bindings = <&to 6>;
            key-positions = <51 52>;
        };

        mouse-rh {
            bindings = <&to 6>;
            key-positions = <55 56>;
        };

        bluetooth {
            bindings = <&to 8>;
            key-positions = <0 11>;
        };
    };

    behaviors {
        apos_under: apos_under {
            compatible = "zmk,behavior-mod-morph";
            label = "APOS_UNDER";
            bindings = <&kp APOS>, <&kp UNDER>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        comm_quest: comm_quest {
            compatible = "zmk,behavior-mod-morph";
            label = "COMM_QUEST";
            bindings = <&kp COMMA>, <&kp QUESTION>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        dash_dbquot: dash_dbquot {
            compatible = "zmk,behavior-mod-morph";
            label = "DASH_DBQUOT";
            bindings = <&kp MINUS>, <&kp DOUBLE_QUOTES>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        slsh_lt: slsh_lt {
            compatible = "zmk,behavior-mod-morph";
            label = "SLSH_LT";
            bindings = <&kp SLASH>, <&kp LT>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // ------------------------------------------------------------------------------------------------------------
            // |  ESC  |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |   `   |
            // |  TAB  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   |   -   |
            // |  CTRL |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
            // | SHIFT |  Z  |  X  |  C   |  V   |  B   |   "["  |  |  "]"  |  N   |  M    |  ,    |  .   |   /   | SHIFT |
            //                     | ALT  | GUI  | LOWER|  SPACE |  | ENTER | RAISE| BSPC  | GUI   |

            display-name = "Graphite";
            bindings = <
&kp ESC    &kp N1  &kp N2  &kp N3  &kp N4  &kp N5                           &kp N6       &kp N7  &kp N8    &kp N9        &kp N0    &kp GRAVE
&kp TAB    &kp B   &kp L   &kp D   &kp W   &kp Z                            &apos_under  &kp F   &kp O     &kp U         &kp J     &kp SEMI
&kp LCTRL  &kp N   &kp R   &kp T   &kp S   &kp G                            &kp Y        &kp H   &kp A     &kp E         &kp I     &comm_quest
&kp LSHFT  &kp Q   &kp X   &kp M   &kp C   &kp V   &kp ENTER    &caps_word  &kp K        &kp P   &kp DOT   &dash_dbquot  &slsh_lt  &mt RGUI BSLH
                           &mo 7   &mo 5   &mo 2   &kp SPACE    &kp LSHFT   &mo 5        &to 2   &kp LALT
            >;
        };

        qwerty {
            bindings = <
&kp ESC    &kp N1  &kp N2  &kp N3  &kp N4  &kp N5                               &kp N6  &kp N7        &kp N8         &kp N9   &kp N0    &kp MINUS
&kp TAB    &kp Q   &kp W   &kp E   &kp R   &kp T                                &kp Y   &kp U         &kp I          &kp O    &kp P     &kp EQUAL
&kp LCTRL  &kp A   &kp S   &kp D   &kp F   &kp G                                &kp H   &kp J         &kp K          &kp L    &kp SEMI  &kp BSLH
&kp LSHFT  &kp Z   &kp X   &kp C   &kp V   &kp B   &kp ENTER    &caps_word      &kp N   &kp M         &kp COMMA      &kp DOT  &kp FSLH  &kp RSHFT
                           &mo 7   &mo 5   &mo 2   &kp SPACE    &kp LEFT_SHIFT  &mo 5   &kp LEFT_ALT  &kp RIGHT_GUI
            >;

            label = "qwerty";
        };

        lower_layer {
            // ------------------------------------------------------------------------------------------------------------
            // | BTCLR | BT1 | BT2 |  BT3 |  BT4 |  BT5 |                   |      |       |       |      |       |       |
            // |  F1   |  F2 |  F3 |  F4  |  F5  |  F6  |                   |  F7  |  F8   |  F9   |  F10 |  F11  |  F12  |
            // |   `   |  !  |  @  |  #   |  $   |  %   |                   |  ^   |  &    |  *    |  (   |   )   |   ~   |
            // |       |     |     |      |      |      |        |  |       |      |  _    |  +    |  {   |   }   |  "|"  |
            //                     |      |      |      |        |  |       |      |       |       |

            display-name = "Extend";
            bindings = <
&trans         &trans      &trans      &trans      &trans         &trans                           &trans     &trans         &trans        &trans      &trans           &trans
&kp LC(LS(S))  &kp ESCAPE  &kp K_BACK  &kp K_FIND  &kp K_FORWARD  &kp INSERT                       &kp PG_UP  &kp HOME       &kp UP_ARROW  &kp END     &kp LC(P)        &trans
&kp LC(S)      &kp LALT    &kp LGUI    &sk LSHFT   &sk LCTRL      &kp LC(A)                        &kp PG_DN  &kp LEFT       &kp DOWN      &kp RIGHT   &kp DELETE       &trans
&trans         &kp LC(Z)   &kp LC(X)   &kp LC(C)   &kp LC(V)      &kp LC(B)   &trans    &trans     &trans     &kp BACKSPACE  &kp TAB       &kp C_MENU  &kp PRINTSCREEN  &trans
                                       &trans      &trans         &trans      &trans    &kp ENTER  &kp LSHFT  &kp LCTRL      &to 0
            >;
        };

        symbols {
            display-name = "Sym";
            bindings = <
&trans  &trans      &trans      &trans         &trans      &trans                              &trans         &trans      &trans        &trans    &trans         &trans
&trans  &kp LS(N1)  &kp LS(N2)  &kp LS(N3)     &kp LS(N4)  &kp LS(NUMBER_5)                    &kp EQUAL      &kp GRAVE   &kp LS(SEMI)  &kp SEMI  &kp LS(EQUAL)  &trans
&trans  &kp LALT    &kp LGUI    &kp LSHFT      &kp LCTRL   &kp LS(N7)                          &kp LS(N8)     &kp LS(N9)  &kp LS(LBKT)  &kp LBKT  &kp MINUS      &trans
&trans  &trans      &trans      &kp BACKSLASH  &kp PIPE    &kp LS(N6)        &trans    &trans  &kp LS(GRAVE)  &kp LS(N0)  &kp LS(RBKT)  &kp RBKT  &kp LS(MINUS)  &trans
                                &trans         &trans      &trans            &trans    &trans  &trans         &trans      &trans
            >;
        };

        function {
            // ------------------------------------------------------------------------------------------------------------
            // |       |     |     |      |      |      |                   |      |       |       |      |       |       |
            // |   `   |  1  |  2  |  3   |  4   |  5   |                   |  6   |   7   |   8   |  9   |   0   |       |
            // |   F1  |  F2 |  F3 |  F4  |  F5  |  F6  |                   |      |   <-  |   v   |  ^   |  ->   |       |
            // |   F7  |  F8 |  F9 |  F10 |  F11 |  F12 |        |  |       |  +   |   -   |   =   |  [   |   ]   |   \   |
            //                     |      |      |      |        |  |       |      |       |       |

            display-name = "Function";
            bindings = <
&trans  &kp LG(LS(NUMBER_1))  &kp LS(LG(NUMBER_2))  &kp LS(LG(NUMBER_3))  &kp LS(LG(NUMBER_4))  &kp LS(LG(N5))                          &kp LS(LG(NUMBER_6))  &kp LS(LG(N7))  &kp LS(LG(N8))  &kp LG(LS(N9))  &trans   &trans
&trans  &kp C_STOP            &kp C_REWIND          &kp C_PLAY            &kp C_FAST_FORWARD    &kp C_BRIGHTNESS_INC                    &trans                &kp F9          &kp F10         &kp F11         &kp F12  &trans
&trans  &kp LALT              &kp LGUI              &sk LSHFT             &sk LCTRL             &kp C_BRIGHTNESS_DEC                    &trans                &kp F5          &kp F6          &kp F7          &kp F8   &trans
&trans  &kp K_MUTE            &kp C_VOL_DN          &kp LS(LC(C))         &kp C_VOLUME_UP       &kp LS(LC(V))         &trans    &trans  &trans                &kp F1          &kp F2          &kp F3          &kp F4   &trans
                                                    &trans                &trans                &trans                &trans    &trans  &trans                &trans          &trans
            >;
        };

        numpad {
            display-name = "Num";
            bindings = <
&trans     &kp LC(N9)  &kp LC(N0)  &kp BSPC  &trans  &trans                           &trans         &trans  &kp BSPC  &kp LS(N9)  &kp LS(N0)  &kp KP_NUM
&trans     &kp MINUS   &kp N7      &kp N8    &kp N9  &kp LS(N8)                       &kp LS(N8)     &kp N7  &kp N8    &kp N9      &kp MINUS   &trans
&kp ENTER  &kp N0      &kp N4      &kp N5    &kp N6  &kp LS(EQUAL)                    &kp LS(EQUAL)  &kp N4  &kp N5    &kp N6      &kp N0      &kp ENTER
&trans     &kp DOT     &kp N1      &kp N2    &kp N3  &kp FSLH       &trans    &trans  &kp FSLH       &kp N1  &kp N2    &kp N3      &kp DOT     &trans
                                   &trans    &trans  &trans         &trans    &trans  &trans         &trans  &trans
            >;
        };

        mouse {
            display-name = "Mouse";
            bindings = <
&trans  &trans     &trans          &msc SCRL_UP    &trans           &trans                                    &trans          &trans          &msc SCRL_UP    &trans           &trans     &trans
&trans  &trans     &mkp MB2        &mmv MOVE_UP    &mkp MB1         &trans                                    &trans          &mkp MB1        &mmv MOVE_UP    &mkp MB2         &trans     &trans
&trans  &kp LCTRL  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &trans                                    &trans          &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &kp LCTRL  &trans
&trans  &trans     &trans          &msc SCRL_DOWN  &trans           &trans          &kp LA(F4)    &kp LA(F4)  &trans          &trans          &msc SCRL_DOWN  &trans           &trans     &trans
                                   &trans          &kp LEFT_ALT     &kp LEFT_SHIFT  &to 0         &to 0       &kp LEFT_SHIFT  &kp LALT        &trans
            >;
        };

        ableton {
            bindings = <
&trans         &kp LC(N1)  &kp LC(N2)  &kp LC(N3)     &kp LC(N4)  &kp LALT                         &trans  &trans  &trans  &trans  &trans  &trans
&kp LC(LA(E))  &kp LC(R)   &kp LC(G)   &kp LS(LC(M))  &kp LC(U)   &kp LS(LC(U))                    &trans  &trans  &trans  &trans  &trans  &trans
&kp LC(T)      &kp LC(S)   &kp LC(L)   &kp LC(D)      &kp LC(F)   &kp LS(LC(F))                    &trans  &trans  &trans  &trans  &trans  &trans
&kp LS(LC(T))  &kp LC(Z)   &kp LC(Y)   &kp LC(C)      &kp LC(V)   &kp LS(LC(R))  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
                                       &trans         &trans      &trans         &trans    &trans  &trans  &trans  &trans
            >;

            label = "ableton";
        };

        bluetooth {
            bindings = <
&bt BT_CLR  &bt BT_SEL 0   &bt BT_SEL 1   &bt BT_SEL 2   &bt BT_SEL 3   &bt BT_SEL 4                     &trans  &trans  &trans  &trans  &trans  &trans
&trans      &bt BT_DISC 0  &bt BT_DISC 1  &bt BT_DISC 2  &bt BT_DISC 3  &bt BT_DISC 4                    &trans  &trans  &trans  &trans  &trans  &trans
&trans      &trans         &trans         &trans         &trans         &trans                           &trans  &trans  &trans  &trans  &trans  &trans
&trans      &trans         &trans         &trans         &trans         &trans         &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
                                          &trans         &trans         &trans         &to 0     &to 0   &trans  &trans  &trans
            >;

            label = "bluetooth";
        };

        hrmods {
            bindings = <
&trans  &trans    &trans    &trans     &trans     &trans                    &trans  &trans     &trans     &trans    &trans    &trans
&trans  &trans    &trans    &trans     &trans     &trans                    &trans  &trans     &trans     &trans    &trans    &trans
&trans  &kp LALT  &kp LGUI  &kp LSHFT  &kp LCTRL  &trans                    &trans  &kp LCTRL  &kp LSHFT  &kp LGUI  &kp LALT  &trans
&trans  &trans    &trans    &trans     &trans     &trans  &trans    &trans  &trans  &trans     &trans     &trans    &trans    &trans
                            &trans     &trans     &trans  &trans    &trans  &trans  &trans     &trans
            >;

            label = "hrmods";
        };
    };
};
