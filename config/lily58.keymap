#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    combos {
        compatible = "zmk,combos";

        Function {
            bindings = <&mo 3>;
            key-positions = <52 55>;
        };

        Sym {
            bindings = <&mo 4>;
            key-positions = <52 54>;
        };

        Mouse {
            bindings = <&mo 6>;
            key-positions = <53 54>;
        };

        qwerty {
            bindings = <&tog 1>;
            key-positions = <23 35>;
        };

        graphite {
            bindings = <&tog 0>;
            key-positions = <10 11>;
        };
    };

    behaviors {
        apos_under: apos_under {
            compatible = "zmk,behavior-mod-morph";
            label = "APOS_UNDER";
            bindings = <&kp APOS>, <&kp UNDER>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        comm_quest: comm_quest {
            compatible = "zmk,behavior-mod-morph";
            label = "COMM_QUEST";
            bindings = <&kp COMMA>, <&kp QUESTION>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        dash_dbquot: dash_dbquot {
            compatible = "zmk,behavior-mod-morph";
            label = "DASH_DBQUOT";
            bindings = <&kp MINUS>, <&kp DOUBLE_QUOTES>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        slsh_lt: slsh_lt {
            compatible = "zmk,behavior-mod-morph";
            label = "SLSH_LT";
            bindings = <&kp SLASH>, <&kp LT>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // ------------------------------------------------------------------------------------------------------------
            // |  ESC  |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |   `   |
            // |  TAB  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   |   -   |
            // |  CTRL |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
            // | SHIFT |  Z  |  X  |  C   |  V   |  B   |   "["  |  |  "]"  |  N   |  M    |  ,    |  .   |   /   | SHIFT |
            //                     | ALT  | GUI  | LOWER|  SPACE |  | ENTER | RAISE| BSPC  | GUI   |

            display-name = "Base";
            bindings = <
&kp ESC    &kp N1  &kp N2  &kp N3    &kp N4            &kp N5                           &kp N6       &kp N7        &kp N8   &kp N9        &kp N0    &kp GRAVE
&kp TAB    &kp B   &kp L   &kp D     &kp W             &kp Z                            &apos_under  &kp F         &kp O    &kp U         &kp J     &kp SEMI
&kp LCTRL  &kp N   &kp R   &kp T     &kp S             &kp G                            &kp Y        &kp H         &kp A    &kp E         &kp I     &comm_quest
&kp LSHFT  &kp Q   &kp X   &kp M     &kp C             &kp V   &kp ENTER    &caps_word  &kp K        &kp P         &kp DOT  &dash_dbquot  &slsh_lt  &kp BSLH
                           &kp LGUI  &kp LEFT_CONTROL  &mo 2   &kp SPACE    &kp LSHFT   &mo 5        &kp LEFT_ALT  &mo 4
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        qwerty {
            bindings = <
&kp ESC    &kp N1  &kp N2  &kp N3    &kp N4     &kp N5                           &kp N6     &kp N7    &kp N8     &kp N9   &kp N0    &kp MINUS
&kp TAB    &kp Q   &kp W   &kp E     &kp R      &kp T                            &kp Y      &kp U     &kp I      &kp O    &kp P     &kp EQUAL
&kp LCTRL  &kp A   &kp S   &kp D     &kp F      &kp G                            &kp H      &kp J     &kp K      &kp L    &kp SEMI  &kp BSLH
&kp LSHFT  &kp Z   &kp X   &kp C     &kp V      &kp B   &kp ENTER    &caps_word  &kp N      &kp M     &kp COMMA  &kp DOT  &kp FSLH  &kp RSHFT
                           &kp LGUI  &kp LCTRL  &mo 2   &kp SPACE    &kp LCTRL   &kp ENTER  &kp LALT  &trans
            >;
        };

        lower_layer {
            // ------------------------------------------------------------------------------------------------------------
            // | BTCLR | BT1 | BT2 |  BT3 |  BT4 |  BT5 |                   |      |       |       |      |       |       |
            // |  F1   |  F2 |  F3 |  F4  |  F5  |  F6  |                   |  F7  |  F8   |  F9   |  F10 |  F11  |  F12  |
            // |   `   |  !  |  @  |  #   |  $   |  %   |                   |  ^   |  &    |  *    |  (   |   )   |   ~   |
            // |       |     |     |      |      |      |        |  |       |      |  _    |  +    |  {   |   }   |  "|"  |
            //                     |      |      |      |        |  |       |      |       |       |

            display-name = "Extend";
            bindings = <
&bt BT_CLR     &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3   &bt BT_SEL 4                       &ext_power EP_ON  &ext_power EP_OFF  &ext_power EP_TOG  &trans      &trans           &trans
&kp LC(LS(S))  &kp ESCAPE    &kp K_BACK    &kp K_FIND    &kp K_FORWARD  &kp INSERT                         &kp PG_UP         &kp HOME           &kp UP_ARROW       &kp END     &kp LC(P)        &trans
&kp LC(S)      &kp LALT      &kp LGUI      &sk LSHFT     &sk LCTRL      &kp LC(A)                          &kp PG_DN         &kp LEFT           &kp DOWN           &kp RIGHT   &kp DELETE       &trans
&trans         &kp LC(Z)     &kp LC(X)     &kp LC(C)     &kp LC(V)      &kp LC(B)     &trans    &trans     &trans            &kp BACKSPACE      &kp TAB            &kp C_MENU  &kp PRINTSCREEN  &trans
                                           &trans        &trans         &trans        &trans    &kp ENTER  &mo 3             &trans             &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        raise_layer {
            // ------------------------------------------------------------------------------------------------------------
            // |       |     |     |      |      |      |                   |      |       |       |      |       |       |
            // |   `   |  1  |  2  |  3   |  4   |  5   |                   |  6   |   7   |   8   |  9   |   0   |       |
            // |   F1  |  F2 |  F3 |  F4  |  F5  |  F6  |                   |      |   <-  |   v   |  ^   |  ->   |       |
            // |   F7  |  F8 |  F9 |  F10 |  F11 |  F12 |        |  |       |  +   |   -   |   =   |  [   |   ]   |   \   |
            //                     |      |      |      |        |  |       |      |       |       |

            display-name = "Function";
            bindings = <
&trans  &kp LG(LS(NUMBER_1))  &kp LS(LG(NUMBER_2))  &kp LS(LG(NUMBER_3))  &kp LS(LG(NUMBER_4))  &kp LS(LG(N5))                          &kp LS(LG(NUMBER_6))  &kp LS(LG(N7))  &kp LS(LG(N8))  &kp LG(LS(N9))  &trans  &trans
&trans  &kp C_STOP            &kp C_REWIND          &kp C_PLAY            &kp C_FAST_FORWARD    &kp C_BRIGHTNESS_INC                    &kp F12               &kp F7          &kp F8          &kp F9          &trans  &trans
&trans  &kp LALT              &kp LGUI              &sk LSHFT             &sk LCTRL             &kp C_BRIGHTNESS_DEC                    &kp F11               &kp F4          &kp F5          &kp F6          &trans  &trans
&trans  &kp K_MUTE            &kp C_VOL_DN          &kp LS(LC(C))         &kp C_VOLUME_UP       &kp LS(LC(V))         &trans    &trans  &kp F10               &kp F1          &kp F2          &kp F3          &trans  &trans
                                                    &trans                &trans                &trans                &trans    &trans  &trans                &trans          &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        symbols {
            display-name = "Sym";
            bindings = <
&trans  &trans      &trans      &trans         &trans      &trans                              &trans         &trans      &trans        &trans    &trans         &trans
&trans  &kp LS(N1)  &kp LS(N2)  &kp LS(N3)     &kp LS(N4)  &kp LS(NUMBER_5)                    &kp EQUAL      &kp GRAVE   &kp LS(SEMI)  &kp SEMI  &kp LS(EQUAL)  &trans
&trans  &kp LALT    &kp LGUI    &kp LSHFT      &kp LCTRL   &kp LS(N7)                          &kp LS(N8)     &kp LS(N9)  &kp LS(LBKT)  &kp LBKT  &kp MINUS      &trans
&trans  &trans      &trans      &kp BACKSLASH  &kp PIPE    &kp LS(N6)        &trans    &trans  &kp LS(GRAVE)  &kp LS(N0)  &kp LS(RBKT)  &kp RBKT  &kp LS(MINUS)  &trans
                                &trans         &trans      &trans            &trans    &trans  &trans         &trans      &trans
            >;
        };

        numpad {
            display-name = "Num";
            bindings = <
&trans  &trans    &trans    &trans         &trans          &trans                    &trans         &trans  &kp BSPC  &kp LS(N9)  &kp LS(N0)  &trans
&trans  &trans    &trans    &trans         &kp KP_NUMLOCK  &trans                    &kp LS(N8)     &kp N7  &kp N8    &kp N9      &kp MINUS   &trans
&trans  &kp LALT  &kp LGUI  &sk LSHFT      &sk LCTRL       &trans                    &kp LS(EQUAL)  &kp N4  &kp N5    &kp N6      &kp N0      &kp ENTER
&trans  &trans    &kp TAB   &kp BACKSPACE  &kp ENTER       &trans  &trans    &trans  &kp FSLH       &kp N1  &kp N2    &kp N3      &kp DOT     &trans
                            &trans         &trans          &trans  &trans    &trans  &trans         &trans  &trans
            >;
        };

        mouse {
            display-name = "Mouse";
            bindings = <
&trans  &trans  &trans  &trans  &trans    &trans                    &trans  &trans          &msc SCRL_UP    &trans           &trans          &trans
&trans  &trans  &trans  &trans  &trans    &trans                    &trans  &mkp MB1        &mmv MOVE_UP    &mkp MB2         &msc SCRL_UP    &trans
&trans  &trans  &trans  &trans  &mkp MB1  &trans                    &trans  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &msc SCRL_DOWN  &trans
&trans  &trans  &trans  &trans  &trans    &trans  &trans    &trans  &trans  &trans          &msc SCRL_DOWN  &trans           &trans          &trans
                        &trans  &trans    &trans  &trans    &trans  &trans  &trans          &trans
            >;
        };
    };
};
